{
  "name": "featherslop",
  "version": "0.1.0",
  "author": "Maciej Małecki <me@mmalecki.com>",
  "description": "Minimal agent execution loop with configurable, context-lean toolsets",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "mvp": "node examples/mvp.ts",
    "web": "node --env-file-if-exists=.env examples/web.ts",
    "chat": "node --env-file-if-exists=.env examples/chat.ts",
    "test": "node --test",
    "claude": "node --env-file-if-exists=.env examples/claude.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "openai": "^7.27.0",
    "parallel-web": "^1.3.5",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@types/node": "^26.6.4",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.131.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
